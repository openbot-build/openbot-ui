{
	"name": "@openbot-build/web",
	"version": "0.1.0",
	"license": "MIT",
	"type": "module",
	"description": "The web app for OpenBot",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"test": "tsc -p tsconfig.test.json && node --test test/*.test.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"prepack": "pnpm build",
		"packages:pack": "node scripts/packages.mjs pack",
		"packages:publish": "node scripts/packages.mjs publish",
		"test:packages": "node --test scripts/packages.test.mjs",
		"client:update": "bash scripts/update-client.sh"
	},
	"devDependencies": {
		"@base-ui/react": "1.9.0",
		"@effect/atom-react": "4.0.7",
		"@effect/platform-browser": "4.0.7",
		"@fontsource-variable/dm-sans": "5.3.0",
		"@fontsource/dm-mono": "5.3.0",
		"@openbot-build/client": "0.1.0",
		"@shadcn/react": "0.3.1",
		"class-variance-authority": "0.7.1",
		"cmdk": "1.1.1",
		"cn": "0.4.0",
		"effect": "4.0.7",
		"lucide-react": "1.61.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-markdown": "10.1.0",
		"react-router": "8.5.0",
		"remark-gfm": "4.0.1",
		"scheduler": "0.28.0",
		"shadcn": "4.22.1",
		"shiki": "4.5.0",
		"sonner": "2.0.8",
		"tw-animate-css": "1.4.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"tailwindcss": "4.3.3",
		"vite": "8.3.4",
		"typescript": "7.0.2"
	},
	"packageManager": "pnpm@9.15.9",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/openbot-build/openbot-ui.git"
	},
	"files": [
		"dist",
		"LICENSE"
	],
	"exports": {
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	}
}
