{
	"name": "@openbot-build/web",
	"version": "0.1.0",
	"license": "MIT",
	"type": "module",
	"description": "The web app for OpenBot",
	"scripts": {
		"dev": "vite --port 5180",
		"build": "pnpm --filter @kaicom/kay-api... build && vite build && pnpm build:runtime",
		"build:runtime": "tsc -p tsconfig.runtime.json && node scripts/runtime-manifest.mjs",
		"preview": "vite preview --port 5180",
		"test": "tsc -p tsconfig.test.json && node --test test/*.test.ts",
		"typecheck": "pnpm -r exec tsc -p tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit",
		"prepack": "pnpm build",
		"packages:pack": "node scripts/packages.mjs pack",
		"packages:publish": "node scripts/packages.mjs publish",
		"test:packages": "node --test scripts/packages.test.mjs",
		"client:update": "bash scripts/update-client.sh",
		"i18n:check": "lingui compile --strict",
		"i18n:extract": "lingui extract",
		"gateway:start": "node --env-file=.env.development packages/kay-api/dist/Main.js",
		"gateway:migrate": "node --env-file=.env.development packages/kay-api/dist/Migrate.js"
	},
	"devDependencies": {
		"@base-ui/react": "1.9.0",
		"@fontsource-variable/dm-sans": "^5.3.0",
		"@kaicom/k": "workspace:^",
		"@kaicom/kay-contracts": "workspace:*",
		"@lingui/cli": "^6.10.0",
		"@lingui/core": "^6.10.0",
		"@lingui/format-po": "^6.10.0",
		"@lingui/react": "^6.10.0",
		"@lingui/vite-plugin": "^6.10.0",
		"@modelcontextprotocol/client": "2.3.1",
		"@playwright/test": "1.64.1",
		"@shadcn/react": "0.3.1",
		"@tailwindcss/vite": "^4.2.0",
		"@types/node": "26.6.5",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"effect": "4.0.5",
		"lucide-react": "^0.577.0",
		"prettier": "3.9.10",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-router": "8.5.0",
		"scheduler": "0.27.0",
		"shadcn": "4.22.0",
		"streamdown": "2.7.0",
		"tailwind-merge": "^3.3.1",
		"tailwindcss": "^4.2.0",
		"tsdown": "0.23.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "7.0.2",
		"vite": "8.3.4"
	},
	"packageManager": "pnpm@9.15.9",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/openbot-build/openbot-ui.git"
	},
	"files": [
		"dist",
		"runtime",
		"LICENSE"
	],
	"exports": {
		"./runtime": {
			"types": "./runtime/runtime.d.ts",
			"default": "./runtime/runtime.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"pnpm": {
		"overrides": {
			"@effect/platform-node@4.0.5>@effect/platform-node-shared": "4.0.5",
			"@effect/platform-node@4.0.7>@effect/platform-node-shared": "4.0.7",
			"@effect/platform-node@4.0.6>@effect/platform-node-shared": "4.0.6"
		},
		"patchedDependencies": {
			"effect@4.0.5": "patches/effect@4.0.5.patch",
			"effect@4.0.6": "patches/effect@4.0.6.patch"
		}
	},
	"dependencies": {
		"@openbot-build/client": "file:vendor/openbot-client-29155b1.tgz"
	}
}
